# Porta local para o OpenCode Web
OPENCODE_PORT=4096

# Hostname para o opencode web (127.0.0.1 para local, 0.0.0.0 crasha dentro do proot - getifaddrs bug)
OPENCODE_HOSTNAME=127.0.0.1

# Tópico para notificação push ntfy.sh
NTFY_TOPIC=opencode-tunnel

# Diretório do projeto (onde está run-cloudflare-tunnel.sh)
PROJECT_DIR=/root/Projetos/opencode_termux

# Porta do SSH server no Termux
SSH_PORT=8022

# Tailscale (opcional — alternativa ao Cloudflare Quick Tunnel)
# Tailscale usa a mesma OPENCODE_PORT para expor na rede mesh.
# TAILSCALE_SERVE_HTTP=true habilita tailscale serve --http (default: true)
TAILSCALE_SERVE_HTTP=true

# Senha do servidor OpenCode V2 — NÃO preencha aqui.
# O .env é versionado; a senha real vive FORA do repo, em
# $PREFIX/tmp/opencode_password.txt (chmod 600), gerada/persistida pelos launchers.
OPENCODE_PASSWORD=
